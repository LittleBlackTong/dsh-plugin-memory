{
  "name": "dsh-plugin-memory",
  "description": "Long-term memory plugin for DeepSeek Harness: persistent cross-session markdown memory with a soul/persona file, auto-injected at every session start, plus remember/recall/consolidate/forget workflows and portable migration tooling.",
  "version": "0.2.1",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "bin": {
    "dsh-memory": "scripts/memory.mjs"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "files": [
    "lib/**",
    "skills/**",
    "scripts/**",
    "docs/**",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/memory.mjs --self-test",
    "test:plugin": "node --test test/plugin-metadata.test.mjs",
    "lint:memory": "node scripts/memory.mjs lint"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "memory",
    "long-term-memory",
    "markdown",
    "wiki",
    "migration"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-skill": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LittleBlackTong/dsh-plugin-memory.git"
  },
  "bugs": {
    "url": "https://github.com/LittleBlackTong/dsh-plugin-memory/issues"
  },
  "homepage": "https://github.com/LittleBlackTong/dsh-plugin-memory#readme"
}
